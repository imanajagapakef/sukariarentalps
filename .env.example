# =============================================================================
# Suka Ria Rental PS — environment
#
# Dev: copy this file to .env.local and fill it in.
# Prod: set the same keys in the hosting dashboard (Vercel → Project → Settings).
# Never commit .env.local (it is gitignored).
# =============================================================================

# --- Supabase (wajib) --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- URL publik situs (wajib di produksi) ------------------------------------
# Dipakai untuk OpenGraph/Twitter share preview dan tautan QR absolut.
# Di Vercel boleh dikosongkan: VERCEL_URL dipakai sebagai fallback.
NEXT_PUBLIC_SITE_URL=

# --- QRIS Dinamis lokal (tanpa gateway) --------------------------------------
# Pelunasan dikonfirmasi manual oleh kasir di /admin/bookings.
QRIS_STATIC_STRING=

# --- Notifikasi WhatsApp (opsional) ------------------------------------------
# Kosong = notifikasi tetap tercatat di tabel `notifications` tapi tidak terkirim.
WA_API_KEY=
# "fonnte" (default) atau "wablas".
WA_PROVIDER=

# --- Bootstrap akun owner (hanya untuk scripts/bootstrap-owner.mjs) ----------
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# --- Integration tests (opsional) --------------------------------------------
# Tanpa ini, test yang butuh database live otomatis di-skip.
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
TEST_DATABASE_URL=
