# Connection strings for integration tests — apunta SETTIDAKNYA ke project uji
# terpisah. JANGAN pakai project produksi: test menulis data asli ke sana.
# Copy this file to .env.test and fill it in.
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
TEST_DATABASE_URL=
# Project uji (dibutuhkan admin-harness + booking-access gate):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase lokal (CI): `supabase start` mengeluarkannya sebagai
# http://127.0.0.1:54321 (anon) dan service_role key dari `supabase status`.